<% content_for :title, t("users.index.title") %>
<% content_for :description, t("users.index.description") %>

<section class="space-y-8 text-[#1a1a1a]" data-page-content>
    <div class="rounded-[32px] border border-[#d8d4ca] bg-[#f7f6f2] px-6 py-8 shadow-[0_24px_80px_rgba(26,26,26,0.08)] lg:px-8 lg:py-10">
        <div class="grid gap-6 lg:grid-cols-[minmax(0,1fr)_18rem] lg:items-end">
            <div class="space-y-4">
                <p class="text-xs font-semibold uppercase tracking-[0.24em] text-[#6b6b6b]"><%= t("editorial.users.index.eyebrow") %></p>
                <h1 class="text-4xl font-medium tracking-[-0.03em] lg:text-5xl"><%= t("users.index.heading") %></h1>
                <p class="max-w-2xl text-base leading-7 text-[#6b6b6b]"><%= t("users.index.lead") %></p>
            </div>

            <div class="rounded-[24px] border border-[#e8e6e1] bg-white p-5">
                <p class="text-sm font-medium text-[#1a1a1a]"><%= t("editorial.users.index.summary_heading") %></p>
                <p class="mt-3 text-sm leading-6 text-[#6b6b6b]"><%= t("editorial.users.index.summary_body") %></p>
            </div>
        </div>
    </div>

    <% if @users.any? %>
    <div class="grid gap-6 md:grid-cols-2 xl:grid-cols-3">
        <% @users.each do |user| %>
        <% top_categories = Array(@top_categories_by_user[user.id]) %>
        <article class="overflow-hidden rounded-[24px] border border-[#e8e6e1] bg-white p-5 shadow-[0_18px_60px_rgba(26,26,26,0.06)] transition duration-300 hover:-translate-y-1 hover:shadow-[0_24px_70px_rgba(26,26,26,0.1)]">
            <div class="space-y-4">
                <div class="space-y-2">
                    <h2 class="text-xl font-medium tracking-[-0.02em]">
                        <%= link_to user.name, user_path(user), class: "transition hover:text-[#6b6b6b]" %>
                    </h2>
                    <p class="text-sm leading-6 text-[#6b6b6b]"><%= truncate(user.bio.presence || t("users.show.no_profile_description"), length: 120) %></p>
                </div>

                <dl class="grid gap-3 sm:grid-cols-2">
                    <div class="rounded-[18px] border border-[#e8e6e1] bg-[#f7f6f2] px-4 py-3">
                        <dt class="text-xs uppercase tracking-[0.18em] text-[#6b6b6b]"><%= t("users.show.published_posts") %></dt>
                        <dd class="mt-1 text-lg font-medium"><%= localized_number(user.read_attribute(:published_posts_count).to_i) %></dd>
                    </div>
                    <div class="rounded-[18px] border border-[#e8e6e1] bg-[#f7f6f2] px-4 py-3">
                        <dt class="text-xs uppercase tracking-[0.18em] text-[#6b6b6b]"><%= t("users.show.recent_activity") %></dt>
                        <dd class="mt-1 text-lg font-medium"><%= user.read_attribute(:last_activity_at).present? ? formatted_date(user.read_attribute(:last_activity_at)) : "-" %></dd>
                    </div>
                </dl>

                <% if top_categories.any? %>
                <div class="flex flex-wrap gap-2">
                    <% top_categories.each do |category| %>
                    <span class="rounded-full border border-[#d8d4ca] bg-[#f7f6f2] px-3 py-1 text-xs font-medium text-[#6b6b6b]"><%= category %></span>
                    <% end %>
                </div>
                <% end %>
            </div>
        </article>
        <% end %>
    </div>
    <% else %>
    <div class="rounded-[28px] border border-[#d8d4ca] bg-white px-6 py-14 text-center shadow-[0_18px_60px_rgba(26,26,26,0.08)]">
        <h2 class="text-3xl font-medium tracking-[-0.03em]"><%= t("users.index.empty") %></h2>
        <p class="mx-auto mt-3 max-w-xl text-sm leading-7 text-[#6b6b6b]"><%= t("users.index.lead") %></p>
        <div class="mt-6">
            <%= link_to t("navigation.create_profile"), new_user_path, class: "inline-flex items-center justify-center rounded-full bg-[#1a1a1a] px-5 py-3 text-sm font-medium text-white transition hover:bg-[#303030]" %>
        </div>
    </div>
    <% end %>
</section>

<section class="hidden" data-page-skeleton aria-hidden="true">
    <%= render "shared/screen_skeleton", variant: :list %>
</section>
