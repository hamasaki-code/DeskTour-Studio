<% content_for :title, @user.name %>
<% content_for :description, truncate(@user.bio.to_s, length: 120) %>
<% create_post_label = t("navigation.create_post") %>
<% browse_gallery_label = t("users.show.browse_gallery") %>
<% draft_hint = t("users.show.draft_visibility_hint") %>
<% top_categories = Array(@profile_stats[:top_categories]) %>

<section class="space-y-8 text-[#1a1a1a]" data-page-content>
    <header class="rounded-[32px] border border-[#d8d4ca] bg-[#f7f6f2] px-6 py-8 shadow-[0_24px_80px_rgba(26,26,26,0.08)] lg:px-8 lg:py-10">
        <div class="grid gap-6 lg:grid-cols-[minmax(0,1fr)_18rem] lg:items-end">
            <div class="space-y-4">
                <p class="text-xs font-semibold uppercase tracking-[0.24em] text-[#6b6b6b]"><%= t("editorial.users.show.eyebrow") %></p>
                <h1 class="text-4xl font-medium tracking-[-0.03em] lg:text-5xl"><%= @user.name %></h1>
                <% if @user.bio.present? %>
                <p class="max-w-2xl whitespace-pre-wrap text-base leading-7 text-[#6b6b6b]"><%= @user.bio %></p>
                <% else %>
                <p class="max-w-2xl text-base leading-7 text-[#6b6b6b]"><%= t("users.show.no_profile_description") %></p>
                <% end %>
            </div>

            <div class="rounded-[24px] border border-[#e8e6e1] bg-white p-5">
                <p class="text-xs font-semibold uppercase tracking-[0.22em] text-[#6b6b6b]"><%= t("editorial.users.show.stats_eyebrow") %></p>
                <dl class="mt-4 space-y-3 text-sm text-[#6b6b6b]">
                    <div class="flex items-center justify-between gap-3">
                        <dt><%= t("users.show.published_posts") %></dt>
                        <dd class="font-medium text-[#1a1a1a]"><%= localized_number(@profile_stats[:published_posts_count]) %></dd>
                    </div>
                    <div class="flex items-center justify-between gap-3">
                        <dt><%= t("users.show.recent_activity") %></dt>
                        <dd class="font-medium text-[#1a1a1a]"><%= @profile_stats[:recent_activity_at].present? ? formatted_date(@profile_stats[:recent_activity_at]) : "-" %></dd>
                    </div>
                    <div class="flex items-start justify-between gap-3">
                        <dt><%= t("users.show.top_categories") %></dt>
                        <dd class="text-right font-medium text-[#1a1a1a]"><%= top_categories.any? ? top_categories.join(" / ") : "-" %></dd>
                    </div>
                </dl>
            </div>
        </div>

        <div class="mt-6 flex flex-wrap gap-3">
            <%= link_to users_path, class: "inline-flex items-center justify-center rounded-full border border-[#d8d4ca] bg-white px-5 py-3 text-sm font-medium text-[#1a1a1a] transition hover:border-[#c7c1b4] hover:bg-[#fcfbf8]" do %>
            <span><%= t("users.show.browse_users") %></span>
            <% end %>

            <% if user_owner?(@user) %>
            <%= link_to edit_user_path(@user), class: "inline-flex items-center justify-center rounded-full border border-[#d8d4ca] bg-white px-5 py-3 text-sm font-medium text-[#1a1a1a] transition hover:border-[#c7c1b4] hover:bg-[#fcfbf8]" do %>
            <span><%= t("users.show.edit_profile") %></span>
            <% end %>
            <%= link_to new_post_path, class: "inline-flex items-center justify-center rounded-full bg-[#1a1a1a] px-5 py-3 text-sm font-medium text-white transition hover:bg-[#303030]" do %>
            <span><%= create_post_label %></span>
            <% end %>
            <% else %>
            <%= link_to gallery_path, class: "inline-flex items-center justify-center rounded-full bg-[#1a1a1a] px-5 py-3 text-sm font-medium text-white transition hover:bg-[#303030]" do %>
            <span><%= browse_gallery_label %></span>
            <% end %>
            <% end %>
        </div>
    </header>

    <section class="space-y-5 rounded-[32px] border border-[#d8d4ca] bg-white p-6 shadow-[0_18px_60px_rgba(26,26,26,0.08)] lg:p-8">
        <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
            <div class="space-y-2">
                <p class="text-xs font-semibold uppercase tracking-[0.22em] text-[#6b6b6b]"><%= t("editorial.users.show.published_eyebrow") %></p>
                <h2 class="text-3xl font-medium tracking-[-0.03em]"><%= t("users.show.published_posts") %></h2>
            </div>
        </div>

        <% if @published_posts.any? %>
        <div class="grid gap-6 md:grid-cols-2 xl:grid-cols-3">
            <% @published_posts.each do |post| %>
            <%= render "shared/editorial_post_card", post: post, destination: post_path(post, from: request.fullpath) %>
            <% end %>
        </div>
        <% else %>
        <div class="rounded-[28px] border border-[#d8d4ca] bg-[#f7f6f2] px-6 py-12 text-center">
            <h2 class="text-3xl font-medium tracking-[-0.03em]"><%= t("editorial.users.show.empty_heading") %></h2>
            <p class="mx-auto mt-3 max-w-xl text-sm leading-7 text-[#6b6b6b]"><%= t("editorial.users.show.empty_body") %></p>
            <div class="mt-6">
                <% action_href = user_owner?(@user) ? new_post_path : gallery_path %>
                <% action_label = user_owner?(@user) ? create_post_label : browse_gallery_label %>
                <%= link_to action_label, action_href, class: "inline-flex items-center justify-center rounded-full bg-[#1a1a1a] px-5 py-3 text-sm font-medium text-white transition hover:bg-[#303030]" %>
            </div>
        </div>
        <% end %>
    </section>

    <% if user_owner?(@user) %>
    <section class="space-y-5 rounded-[32px] border border-[#d8d4ca] bg-[#f7f6f2] p-6 shadow-[0_18px_60px_rgba(26,26,26,0.08)] lg:p-8">
        <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
            <div class="space-y-2">
                <p class="text-xs font-semibold uppercase tracking-[0.22em] text-[#6b6b6b]"><%= t("editorial.users.show.drafts_eyebrow") %></p>
                <h2 class="text-3xl font-medium tracking-[-0.03em]"><%= t("users.show.drafts") %></h2>
            </div>
            <p class="max-w-xl text-sm leading-6 text-[#6b6b6b]"><%= draft_hint %></p>
        </div>

        <% if @draft_posts.any? %>
        <div class="grid gap-4 md:grid-cols-2">
            <% @draft_posts.each do |post| %>
            <article class="rounded-[24px] border border-[#e8e6e1] bg-white p-5 shadow-[0_18px_60px_rgba(26,26,26,0.06)]">
                <div class="space-y-3">
                    <h3 class="text-xl font-medium tracking-[-0.02em]"><%= post.title.presence || t("users.show.untitled_draft") %></h3>
                    <p class="text-sm leading-6 text-[#6b6b6b]"><%= truncate(post.description.to_s, length: 140) %></p>
                    <div class="flex flex-wrap items-center justify-between gap-3 text-sm text-[#6b6b6b]">
                        <span><%= formatted_date(post.updated_at) %></span>
                        <%= link_to t("users.show.continue_editing"), edit_post_path(post), class: "font-medium text-[#1a1a1a] underline decoration-[#d8d4ca] underline-offset-4 transition hover:decoration-[#1a1a1a]" %>
                    </div>
                </div>
            </article>
            <% end %>
        </div>
        <% else %>
        <div class="rounded-[28px] border border-[#d8d4ca] bg-white px-6 py-12 text-center">
            <h2 class="text-3xl font-medium tracking-[-0.03em]"><%= t("users.show.no_drafts") %></h2>
            <p class="mx-auto mt-3 max-w-xl text-sm leading-7 text-[#6b6b6b]"><%= draft_hint %></p>
            <div class="mt-6">
                <%= link_to create_post_label, new_post_path, class: "inline-flex items-center justify-center rounded-full bg-[#1a1a1a] px-5 py-3 text-sm font-medium text-white transition hover:bg-[#303030]" %>
            </div>
        </div>
        <% end %>
    </section>
    <% end %>
</section>

<section class="hidden" data-page-skeleton aria-hidden="true">
    <%= render "shared/screen_skeleton", variant: :list %>
</section>
