<% content_for :title, t("operator.page.title") %>
<% content_for :description, t("operator.page.description") %>

<section class="space-y-8 text-[#1a1a1a]" data-page-content>
    <div class="rounded-[32px] border border-[#d8d4ca] bg-[#f7f6f2] px-6 py-8 shadow-[0_24px_80px_rgba(26,26,26,0.08)] lg:px-8 lg:py-10">
        <div class="grid gap-6 lg:grid-cols-[minmax(0,1fr)_18rem] lg:items-end">
            <div class="space-y-4">
                <p class="text-xs font-semibold uppercase tracking-[0.24em] text-[#6b6b6b]"><%= t("operator.page.eyebrow") %></p>
                <h1 class="text-4xl font-medium tracking-[-0.03em] lg:text-5xl"><%= t("operator.page.heading") %></h1>
                <p class="max-w-2xl text-base leading-7 text-[#6b6b6b]"><%= t("operator.page.lead") %></p>
            </div>

            <div class="rounded-[24px] border border-[#e8e6e1] bg-white p-5">
                <p class="text-sm font-medium text-[#1a1a1a]"><%= t("operator.page.summary_heading") %></p>
                <ul class="mt-3 space-y-3 text-sm leading-6 text-[#6b6b6b]">
                    <% t("operator.page.summary_points").each do |point| %>
                    <li><%= point %></li>
                    <% end %>
                </ul>
            </div>
        </div>
    </div>

    <section class="grid gap-6 lg:grid-cols-[minmax(0,1fr)_minmax(0,0.9fr)]">
        <article class="rounded-[28px] border border-[#d8d4ca] bg-white p-6 shadow-[0_18px_60px_rgba(26,26,26,0.06)]">
            <p class="text-xs font-semibold uppercase tracking-[0.22em] text-[#6b6b6b]"><%= t("operator.page.info_eyebrow") %></p>
            <h2 class="mt-2 text-2xl font-medium tracking-[-0.03em]"><%= t("operator.page.info_heading") %></h2>
            <dl class="mt-6 space-y-4 text-sm leading-7 text-[#6b6b6b]">
                <div class="rounded-[20px] border border-[#e8e6e1] bg-[#f7f6f2] px-4 py-4">
                    <dt class="text-xs font-semibold uppercase tracking-[0.18em] text-[#9a9487]"><%= t("operator.page.fields.site_name") %></dt>
                    <dd class="mt-2 text-base text-[#1a1a1a]">DeskTour Studio</dd>
                </div>
                <div class="rounded-[20px] border border-[#e8e6e1] bg-[#f7f6f2] px-4 py-4">
                    <dt class="text-xs font-semibold uppercase tracking-[0.18em] text-[#9a9487]"><%= t("operator.page.fields.operator_name") %></dt>
                    <dd class="mt-2 text-base text-[#1a1a1a]"><%= ENV["SITE_OPERATOR_NAME"].presence || t("operator.page.defaults.operator_name") %></dd>
                </div>
                <div class="rounded-[20px] border border-[#e8e6e1] bg-[#f7f6f2] px-4 py-4">
                    <dt class="text-xs font-semibold uppercase tracking-[0.18em] text-[#9a9487]"><%= t("operator.page.fields.contact") %></dt>
                    <dd class="mt-2 text-base text-[#1a1a1a]"><%= t("operator.page.contact_via_support_html", support_link: link_to(t("support.page.link_label"), support_path, class: "underline decoration-[#c7c1b4] underline-offset-4")) %></dd>
                </div>
                <div class="rounded-[20px] border border-[#e8e6e1] bg-[#f7f6f2] px-4 py-4">
                    <dt class="text-xs font-semibold uppercase tracking-[0.18em] text-[#9a9487]"><%= t("operator.page.fields.policy") %></dt>
                    <dd class="mt-2 text-base text-[#1a1a1a]"><%= t("operator.page.policy_note") %></dd>
                </div>
            </dl>
        </article>

        <article class="rounded-[28px] border border-[#d8d4ca] bg-[#f7f6f2] p-6 shadow-[0_18px_60px_rgba(26,26,26,0.06)]">
            <p class="text-xs font-semibold uppercase tracking-[0.22em] text-[#6b6b6b]"><%= t("operator.page.editorial_eyebrow") %></p>
            <h2 class="mt-2 text-2xl font-medium tracking-[-0.03em]"><%= t("operator.page.editorial_heading") %></h2>
            <div class="mt-4 space-y-4 text-sm leading-7 text-[#6b6b6b]">
                <% t("operator.page.editorial_body").each do |paragraph| %>
                <p><%= paragraph %></p>
                <% end %>
            </div>
        </article>
    </section>
</section>
