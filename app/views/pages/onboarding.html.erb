<% content_for :title, t("onboarding.title") %>
<% content_for :description, t("onboarding.description") %>

<section class="space-y-8 text-[#1a1a1a]" data-page-content>
    <div class="rounded-[32px] border border-[#d8d4ca] bg-[#f7f6f2] px-6 py-8 shadow-[0_24px_80px_rgba(26,26,26,0.08)] lg:px-8 lg:py-10">
        <div class="grid gap-6 lg:grid-cols-[minmax(0,1fr)_18rem] lg:items-end">
            <div class="space-y-4">
                <p class="text-xs font-semibold uppercase tracking-[0.24em] text-[#6b6b6b]"><%= t("editorial.onboarding.eyebrow") %></p>
                <h1 class="text-4xl font-medium tracking-[-0.03em] lg:text-5xl"><%= t("onboarding.heading") %></h1>
                <p class="max-w-2xl text-base leading-7 text-[#6b6b6b]"><%= t("onboarding.lead") %></p>
            </div>

            <div class="rounded-[24px] border border-[#e8e6e1] bg-white p-5">
                <p class="text-sm font-medium text-[#1a1a1a]"><%= t("editorial.onboarding.note_heading") %></p>
                <p class="mt-3 text-sm leading-6 text-[#6b6b6b]"><%= t("editorial.onboarding.note_body") %></p>
            </div>
        </div>
    </div>

    <section class="rounded-[32px] border border-[#d8d4ca] bg-white p-6 shadow-[0_18px_60px_rgba(26,26,26,0.08)] lg:p-8" aria-label="<%= t('onboarding.progress_title') %>">
        <div class="flex flex-wrap items-center justify-between gap-3">
            <div>
                <p class="text-xs font-semibold uppercase tracking-[0.22em] text-[#6b6b6b]"><%= t("onboarding.progress_title") %></p>
                <p class="mt-2 text-2xl font-medium tracking-[-0.02em]"><%= t("onboarding.progress_value") %></p>
            </div>
            <ol class="flex flex-wrap gap-2">
                <li class="rounded-full border border-[#d8d4ca] bg-[#f7f6f2] px-4 py-2 text-sm font-medium text-[#6b6b6b]"><%= t("onboarding.step") %> 1</li>
                <li class="rounded-full border border-[#d8d4ca] bg-[#f7f6f2] px-4 py-2 text-sm font-medium text-[#6b6b6b]"><%= t("onboarding.step") %> 2</li>
                <li class="rounded-full border border-[#1a1a1a] bg-[#1a1a1a] px-4 py-2 text-sm font-medium text-white"><%= t("onboarding.step") %> 3</li>
            </ol>
        </div>

        <div class="mt-5 h-2 overflow-hidden rounded-full bg-[#ece8df]" role="progressbar" aria-valuemin="1" aria-valuemax="3" aria-valuenow="3" aria-label="<%= t('onboarding.progress_title') %>">
            <div class="h-full w-full rounded-full bg-[#1a1a1a]"></div>
        </div>
    </section>

    <ol class="grid gap-6 lg:grid-cols-3">
        <li class="rounded-[28px] border border-[#d8d4ca] bg-white p-6 shadow-[0_18px_60px_rgba(26,26,26,0.06)]">
            <p class="text-xs font-semibold uppercase tracking-[0.22em] text-[#6b6b6b]"><%= t("onboarding.step") %> 1</p>
            <h2 class="mt-2 text-2xl font-medium tracking-[-0.03em]"><%= t("onboarding.browse_title") %></h2>
            <p class="mt-3 text-sm leading-7 text-[#6b6b6b]"><%= t("onboarding.browse_body") %></p>
            <div class="mt-5">
                <%= link_to t("onboarding.browse_cta"), gallery_path, class: "inline-flex items-center justify-center rounded-full border border-[#d8d4ca] bg-[#f7f6f2] px-5 py-3 text-sm font-medium text-[#1a1a1a] transition hover:border-[#c7c1b4] hover:bg-[#fcfbf8]" %>
            </div>
        </li>

        <li class="rounded-[28px] border border-[#d8d4ca] bg-[#f7f6f2] p-6 shadow-[0_18px_60px_rgba(26,26,26,0.06)]">
            <p class="text-xs font-semibold uppercase tracking-[0.22em] text-[#6b6b6b]"><%= t("onboarding.step") %> 2</p>
            <h2 class="mt-2 text-2xl font-medium tracking-[-0.03em]"><%= t("onboarding.post_title") %></h2>
            <p class="mt-3 text-sm leading-7 text-[#6b6b6b]"><%= t("onboarding.post_body") %></p>
            <div class="mt-5">
                <%= link_to t("onboarding.create_post"), new_post_path, class: "inline-flex items-center justify-center rounded-full bg-[#1a1a1a] px-5 py-3 text-sm font-medium text-white transition hover:bg-[#303030]" %>
            </div>
        </li>

        <li class="rounded-[28px] border border-[#d8d4ca] bg-white p-6 shadow-[0_18px_60px_rgba(26,26,26,0.06)]">
            <p class="text-xs font-semibold uppercase tracking-[0.22em] text-[#6b6b6b]"><%= t("onboarding.step") %> 3</p>
            <h2 class="mt-2 text-2xl font-medium tracking-[-0.03em]"><%= t("onboarding.revisit_title") %></h2>
            <p class="mt-3 text-sm leading-7 text-[#6b6b6b]"><%= t("onboarding.revisit_body") %></p>
            <div class="mt-5">
                <%= link_to t("onboarding.find_post"), gallery_path, class: "inline-flex items-center justify-center rounded-full border border-[#d8d4ca] bg-[#f7f6f2] px-5 py-3 text-sm font-medium text-[#1a1a1a] transition hover:border-[#c7c1b4] hover:bg-[#fcfbf8]" %>
            </div>
        </li>
    </ol>

    <section class="rounded-[28px] border border-[#d8d4ca] bg-white px-6 py-6 shadow-[0_18px_60px_rgba(26,26,26,0.06)]">
        <p class="text-xs font-semibold uppercase tracking-[0.22em] text-[#6b6b6b]"><%= t("editorial.onboarding.quick_links_heading") %></p>
        <div class="mt-4 flex flex-wrap gap-3 text-sm text-[#6b6b6b]">
            <%= link_to t("footer.terms"), terms_path, class: "transition hover:text-[#1a1a1a]" %>
            <%= link_to t("footer.privacy_policy"), privacy_policy_path, class: "transition hover:text-[#1a1a1a]" %>
            <%= link_to t("footer.cookie_policy"), cookie_policy_path, class: "transition hover:text-[#1a1a1a]" %>
            <%= link_to t("support.page.link_label"), support_path, class: "transition hover:text-[#1a1a1a]" %>
        </div>
    </section>
</section>

<section class="hidden" data-page-skeleton aria-hidden="true">
    <%= render "shared/screen_skeleton", variant: :guide %>
</section>
