<% content_for :title, "Post Management" %>

<section class="space-y-4" data-page-content>
  <div class="flex flex-wrap items-center justify-between gap-3">
    <h1 class="ds-heading-xl">Post Management</h1>
  </div>
  <div class="overflow-x-auto rounded-xl border ds-border-subtle ds-surface-base">
    <table class="min-w-full text-left text-sm">
      <thead class="ds-surface-muted ds-text-weak">
        <tr>
          <th class="px-4 py-3">Title</th>
          <th class="px-4 py-3">Status</th>
          <th class="px-4 py-3">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% @posts.each do |post| %>
          <tr class="border-t ds-border-subtle">
            <td class="px-4 py-3">
              <% if post.published? %>
                <%= link_to post.title, post_path(post), class: "ds-link-primary" %>
              <% else %>
                <span><%= post.title.presence || "(Untitled draft)" %></span>
              <% end %>
            </td>
            <td class="px-4 py-3"><%= post_status_badge(post.status) %></td>
            <td class="px-4 py-3">
              <div class="flex flex-wrap gap-2">
                <% next_status = post.published? ? "draft" : "published" %>
                <%= button_to "Set #{next_status}", admin_post_path(post, status: next_status), method: :patch, class: "tap-target cta-tertiary cta-compact" %>
                <%= button_to "Delete", admin_post_path(post), method: :delete, data: { confirm_action: true, confirm_title: "Delete this post?", confirm_message: "This action permanently removes the post from the admin list.", confirm_label: "Delete", confirm_level: "danger" }, class: "tap-target cta-danger cta-compact" %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</section>
