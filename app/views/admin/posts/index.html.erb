<% content_for :title, "Post Management" %>

<section class="space-y-4">
  <div class="flex flex-wrap items-center justify-between gap-3">
    <h1 class="text-2xl font-bold text-slate-900">Post Management</h1>
    <%= link_to "Report Queue", admin_reports_path, class: "rounded border border-slate-300 px-3 py-1 text-xs hover:bg-slate-100" %>
  </div>
  <div class="overflow-x-auto rounded-xl border border-slate-200 bg-white">
    <table class="min-w-full text-left text-sm">
      <thead class="bg-slate-50 text-slate-600">
        <tr>
          <th class="px-4 py-3">Title</th>
          <th class="px-4 py-3">Status</th>
          <th class="px-4 py-3">Comments</th>
          <th class="px-4 py-3">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% @posts.each do |post| %>
          <tr class="border-t border-slate-200">
            <td class="px-4 py-3">
              <% if post.published? %>
                <%= link_to post.title, post_path(post), class: "text-blue-600 hover:text-blue-700" %>
              <% else %>
                <span><%= post.title.presence || "(Untitled draft)" %></span>
              <% end %>
            </td>
            <td class="px-4 py-3"><%= post_status_badge(post.status) %></td>
            <td class="px-4 py-3"><%= localized_number(post.comments.count) %></td>
            <td class="px-4 py-3">
              <div class="flex flex-wrap gap-2">
                <% next_status = post.published? ? "draft" : "published" %>
                <%= button_to "Set #{next_status}", admin_post_path(post, status: next_status), method: :patch, class: "rounded border border-slate-300 px-3 py-1 text-xs hover:bg-slate-100" %>
                <%= button_to "Delete", admin_post_path(post), method: :delete, data: { turbo_confirm: "Delete this post?" }, class: "rounded border border-red-300 px-3 py-1 text-xs text-red-700 hover:bg-red-50" %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</section>
