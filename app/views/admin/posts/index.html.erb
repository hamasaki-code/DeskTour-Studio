<% content_for :title, "投稿管理" %>

<section class="space-y-4">
  <h1 class="text-2xl font-bold text-slate-900">投稿管理</h1>
  <div class="overflow-x-auto rounded-xl border border-slate-200 bg-white">
    <table class="min-w-full text-left text-sm">
      <thead class="bg-slate-50 text-slate-600">
        <tr>
          <th class="px-4 py-3">タイトル</th>
          <th class="px-4 py-3">公開状態</th>
          <th class="px-4 py-3">コメント数</th>
          <th class="px-4 py-3">操作</th>
        </tr>
      </thead>
      <tbody>
        <% @posts.each do |post| %>
          <tr class="border-t border-slate-200">
            <td class="px-4 py-3">
              <% if post.published? %>
                <%= link_to post.title, post_path(post), class: "text-blue-600 hover:text-blue-700" %>
              <% else %>
                <span><%= post.title %></span>
              <% end %>
            </td>
            <td class="px-4 py-3"><%= post.published? ? "公開" : "非公開" %></td>
            <td class="px-4 py-3"><%= post.comments.count %></td>
            <td class="px-4 py-3">
              <div class="flex flex-wrap gap-2">
                <%= button_to(post.published? ? "非公開にする" : "公開する", admin_post_path(post, published: !post.published?), method: :patch, class: "rounded border border-slate-300 px-3 py-1 text-xs hover:bg-slate-100") %>
                <%= button_to "削除", admin_post_path(post), method: :delete, data: { turbo_confirm: "投稿を削除しますか？" }, class: "rounded border border-red-300 px-3 py-1 text-xs text-red-700 hover:bg-red-50" %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</section>
