<% content_for :title, "Report Queue" %>

<section class="space-y-6" data-page-content>
  <div class="flex flex-wrap items-center justify-between gap-3">
    <h1 class="ds-heading-xl">Report Queue</h1>
    <%= link_to "Post Management", admin_posts_path, class: "tap-target cta-secondary cta-compact" %>
  </div>

  <div class="overflow-x-auto rounded-xl border ds-border-subtle ds-surface-base">
    <table class="min-w-full text-left text-sm">
      <thead class="ds-surface-muted ds-text-weak">
        <tr>
          <th class="px-4 py-3">Post</th>
          <th class="px-4 py-3">Reason</th>
          <th class="px-4 py-3">Reporter</th>
          <th class="px-4 py-3">Details</th>
          <th class="px-4 py-3">Reported At</th>
          <th class="px-4 py-3">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% if @queued_reports.any? %>
          <% @queued_reports.each do |report| %>
            <tr class="border-t ds-border-subtle align-top">
              <td class="px-4 py-3">
                <% if report.post&.published? %>
                  <%= link_to report.post.title, post_path(report.post), class: "ds-link-primary" %>
                <% else %>
                  <span><%= report.post&.title.presence || "(Deleted post)" %></span>
                <% end %>
                <% if report.post&.hidden? %>
                  <p class="mt-1 text-xs ds-text-warning">Currently hidden</p>
                <% end %>
              </td>
              <td class="px-4 py-3"><%= Report.reason_label(report.reason) %></td>
              <td class="px-4 py-3"><%= report.reporter_user&.name.presence || "Anonymous" %></td>
              <td class="px-4 py-3"><%= truncate(report.details.to_s, length: 120) %></td>
              <td class="px-4 py-3"><%= timestamp_tag(report.created_at, style: :datetime) %></td>
              <td class="px-4 py-3">
                <div class="flex flex-wrap gap-2">
                  <%= button_to "Restore", restore_post_admin_report_path(report), method: :patch, class: "tap-target cta-secondary cta-compact" %>
                  <%= button_to "Dismiss", dismiss_admin_report_path(report), method: :patch, class: "tap-target cta-tertiary cta-compact" %>
                  <%= button_to "Delete Post", delete_post_admin_report_path(report), method: :delete, data: { turbo_confirm: "Delete this post permanently?" }, class: "tap-target cta-danger cta-compact" %>
                </div>
              </td>
            </tr>
          <% end %>
        <% else %>
          <tr class="border-t ds-border-subtle">
            <td colspan="6" class="px-4 py-6 text-center ds-text-weak">No queued reports.</td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <div class="overflow-x-auto rounded-xl border ds-border-subtle ds-surface-base">
    <div class="border-b ds-border-subtle px-4 py-3">
      <h2 class="text-sm font-semibold ds-text-strong">Recently reviewed</h2>
    </div>
    <table class="min-w-full text-left text-sm">
      <thead class="ds-surface-muted ds-text-weak">
        <tr>
          <th class="px-4 py-3">Post</th>
          <th class="px-4 py-3">Reason</th>
          <th class="px-4 py-3">Status</th>
          <th class="px-4 py-3">Reviewed At</th>
        </tr>
      </thead>
      <tbody>
        <% if @reviewed_reports.any? %>
          <% @reviewed_reports.each do |report| %>
            <tr class="border-t ds-border-subtle">
              <td class="px-4 py-3"><%= report.post&.title.presence || "(Deleted post)" %></td>
              <td class="px-4 py-3"><%= Report.reason_label(report.reason) %></td>
              <td class="px-4 py-3"><%= report_status_badge(report.status) %></td>
              <td class="px-4 py-3"><%= report.reviewed_at.present? ? timestamp_tag(report.reviewed_at, style: :datetime) : "-" %></td>
            </tr>
          <% end %>
        <% else %>
          <tr class="border-t ds-border-subtle">
            <td colspan="4" class="px-4 py-6 text-center ds-text-weak">No reviewed reports.</td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</section>
