<% content_for :title, t("posts.index.title") %>
<% content_for :description, t("posts.index.description") %>
<% keyword = params[:q].to_s.strip %>
<% selected_category = params[:category].to_s.strip %>
<% selected_theme = params[:theme].to_s.strip %>
<% selected_tag = params[:tag].to_s.strip %>
<% sort_option = @sort_option.presence || "newest" %>
<% active_filters = {
  q: keyword,
  category: selected_category,
  theme: selected_theme,
  tag: selected_tag
}.select { |_, value| value.present? } %>
<% demo_posts = editorial_demo_content_enabled? ? filtered_editorial_demo_posts(query: keyword, category: selected_category, theme: selected_theme, tag: selected_tag, sort: sort_option, limit: 4) : [] %>
<% use_demo_posts = editorial_demo_content_enabled? && @posts.blank? && @popular_tags.blank? && @search_suggestions.blank? && @categories.blank? && @themes.blank? %>
<% display_posts = @posts.presence || (use_demo_posts ? demo_posts : []) %>
<% display_tags = @popular_tags.presence || display_posts.flat_map { |entry| editorial_entry_tags(entry) }.uniq.first(8) %>

<div class="space-y-10 text-[#1a1a1a]">
    <section class="overflow-hidden rounded-[32px] border border-[#d8d4ca] bg-[#f7f6f2] shadow-[0_24px_80px_rgba(0,0,0,0.12)]">
        <div class="grid gap-8 px-6 py-8 lg:grid-cols-[minmax(0,1fr)_18rem] lg:items-end lg:px-10 lg:py-10">
            <div class="space-y-4">
                <p class="text-xs font-semibold uppercase tracking-[0.26em] text-[#6b6b6b]"><%= t("editorial.gallery.eyebrow") %></p>
                <h1 class="max-w-3xl text-4xl font-medium tracking-[-0.03em] lg:text-5xl">
                    <%= t("editorial.gallery.heading") %>
                </h1>
                <p class="max-w-2xl text-base leading-7 text-[#6b6b6b]">
                    <%= t("editorial.gallery.lead") %>
                </p>
            </div>

            <div class="rounded-[28px] border border-[#e8e6e1] bg-white p-5">
                <p class="text-xs font-semibold uppercase tracking-[0.22em] text-[#6b6b6b]"><%= t("editorial.gallery.summary_eyebrow") %></p>
                <dl class="mt-4 grid gap-4">
                    <div>
                        <dt class="text-sm text-[#6b6b6b]"><%= t("editorial.gallery.visible_workspaces") %></dt>
                        <dd class="mt-1 text-3xl font-medium"><%= localized_number(display_posts.size) %></dd>
                    </div>
                    <div>
                        <dt class="text-sm text-[#6b6b6b]"><%= t("editorial.gallery.popular_themes") %></dt>
                        <dd class="mt-1 text-3xl font-medium"><%= localized_number(display_tags.size) %></dd>
                    </div>
                </dl>
            </div>
        </div>
    </section>

    <section class="rounded-[32px] border border-[#d8d4ca] bg-white p-6 shadow-[0_18px_60px_rgba(26,26,26,0.08)] lg:p-8">
        <%= form_with url: gallery_path, method: :get, local: true, class: "space-y-5" do %>
        <div class="grid gap-4 lg:grid-cols-[minmax(0,1fr)_12rem_auto]">
            <label class="relative block">
                <span class="sr-only"><%= t("posts.index.search_button") %></span>
                <%= text_field_tag :q, keyword, class: "w-full rounded-full border border-[#d8d4ca] bg-[#f7f6f2] px-5 py-3.5 text-sm text-[#1a1a1a] placeholder:text-[#8a8479] focus:border-[#1a1a1a] focus:outline-none", placeholder: t("posts.index.search_placeholder"), list: "post-search-suggestions" %>
            </label>
            <%= select_tag :sort, options_for_select([[t("posts.index.sort_newest"), "newest"], [t("posts.index.sort_popular"), "popular"], [t("posts.index.sort_recently_updated"), "recently_updated"]], sort_option), class: "rounded-full border border-[#d8d4ca] bg-[#f7f6f2] px-4 py-3.5 text-sm text-[#1a1a1a] focus:border-[#1a1a1a] focus:outline-none" %>
            <div class="flex flex-wrap gap-3">
                <%= submit_tag t("posts.index.search_button"), class: "inline-flex cursor-pointer items-center justify-center rounded-full bg-[#1a1a1a] px-5 py-3 text-sm font-medium text-white transition hover:bg-[#303030]" %>
                <% if active_filters.any? || sort_option != "newest" %>
                <%= link_to t("posts.index.reset_button"), gallery_path, class: "inline-flex items-center justify-center rounded-full border border-[#d8d4ca] bg-white px-5 py-3 text-sm font-medium text-[#1a1a1a] transition hover:border-[#c7c1b4] hover:bg-[#fcfbf8]" %>
                <% end %>
            </div>
        </div>

        <div class="grid gap-4 lg:grid-cols-3">
            <%= select_tag :category, options_for_select([[t("posts.index.category_placeholder"), ""]] + @categories.map { |category| [category, category] }, selected_category), class: "rounded-[20px] border border-[#d8d4ca] bg-[#f7f6f2] px-4 py-3 text-sm text-[#1a1a1a] focus:border-[#1a1a1a] focus:outline-none" %>
            <%= text_field_tag :theme, selected_theme, class: "rounded-[20px] border border-[#d8d4ca] bg-[#f7f6f2] px-4 py-3 text-sm text-[#1a1a1a] placeholder:text-[#8a8479] focus:border-[#1a1a1a] focus:outline-none", placeholder: t("posts.index.theme_placeholder"), list: "theme-options" %>
            <%= text_field_tag :tag, selected_tag, class: "rounded-[20px] border border-[#d8d4ca] bg-[#f7f6f2] px-4 py-3 text-sm text-[#1a1a1a] placeholder:text-[#8a8479] focus:border-[#1a1a1a] focus:outline-none", placeholder: t("posts.index.tag_placeholder") %>
        </div>
        <% end %>

        <% if display_tags.any? %>
        <div class="mt-5 border-t border-[#ece8df] pt-5">
            <p class="mb-3 text-xs font-semibold uppercase tracking-[0.22em] text-[#6b6b6b]"><%= t("editorial.gallery.popular_tags") %></p>
            <div class="flex flex-wrap gap-2">
                <%= link_to t("editorial.gallery.all_tags"), gallery_path(q: keyword.presence, category: selected_category.presence, theme: selected_theme.presence, sort: sort_option), class: "rounded-full border px-4 py-2 text-sm font-medium transition #{selected_tag.blank? ? 'border-[#1a1a1a] bg-[#1a1a1a] text-white' : 'border-[#d8d4ca] bg-[#f7f6f2] text-[#1a1a1a] hover:border-[#c7c1b4] hover:bg-[#fcfbf8]'}" %>
                <% display_tags.each do |tag| %>
                <%= link_to tag, gallery_path(q: keyword.presence, category: selected_category.presence, theme: selected_theme.presence, tag: tag, sort: sort_option), class: "rounded-full border px-4 py-2 text-sm font-medium transition #{selected_tag == tag ? 'border-[#1a1a1a] bg-[#1a1a1a] text-white' : 'border-[#d8d4ca] bg-[#f7f6f2] text-[#1a1a1a] hover:border-[#c7c1b4] hover:bg-[#fcfbf8]'}" %>
                <% end %>
            </div>
        </div>
        <% end %>

        <% if @search_suggestions.any? %>
        <datalist id="post-search-suggestions">
            <% @search_suggestions.each do |suggestion| %>
            <option value="<%= suggestion %>"></option>
            <% end %>
        </datalist>
        <% end %>

        <% if @themes.any? %>
        <datalist id="theme-options">
            <% @themes.each do |theme| %>
            <option value="<%= theme %>"></option>
            <% end %>
        </datalist>
        <% end %>
    </section>

    <section class="space-y-5">
        <div class="flex flex-col gap-3 rounded-[28px] border border-[#d8d4ca] bg-[#f7f6f2] px-6 py-5 sm:flex-row sm:items-end sm:justify-between">
            <div>
                <p class="text-xs font-semibold uppercase tracking-[0.22em] text-[#6b6b6b]"><%= t("editorial.gallery.results_eyebrow") %></p>
                <h2 class="mt-2 text-2xl font-medium tracking-[-0.03em]">
                    <%= t("posts.index.result_count", count: localized_number(display_posts.size)) %>
                </h2>
            </div>
            <% if active_filters.any? %>
            <p class="max-w-xl text-sm leading-6 text-[#6b6b6b]">
                <%= t("editorial.gallery.filtered_by", filters: active_filters.map { |key, value| "#{editorial_filter_label(key)}: #{value}" }.join(" / ")) %>
            </p>
            <% else %>
            <p class="max-w-xl text-sm leading-6 text-[#6b6b6b]">
                <%= t("editorial.gallery.results_lead") %>
            </p>
            <% end %>
        </div>

        <% if display_posts.any? %>
        <div class="grid gap-6 md:grid-cols-2 xl:grid-cols-3">
            <% display_posts.each do |post| %>
            <% destination = post.is_a?(Hash) ? nil : post_path(post, from: request.fullpath) %>
            <%= render "shared/editorial_post_card", post: post, destination: destination %>
            <% end %>
        </div>
        <% else %>
        <div class="rounded-[28px] border border-[#d8d4ca] bg-white px-6 py-14 text-center shadow-[0_18px_60px_rgba(26,26,26,0.08)]">
            <p class="text-xs font-semibold uppercase tracking-[0.22em] text-[#6b6b6b]"><%= t("editorial.gallery.no_matches_eyebrow") %></p>
            <h2 class="mt-3 text-3xl font-medium tracking-[-0.03em]"><%= t("posts.index.zero_title") %></h2>
            <p class="mx-auto mt-3 max-w-xl text-sm leading-7 text-[#6b6b6b]"><%= t("posts.index.zero_hint") %></p>
            <div class="mt-6">
                <%= link_to t("posts.index.reset_button"), gallery_path, class: "inline-flex items-center justify-center rounded-full bg-[#1a1a1a] px-5 py-3 text-sm font-medium text-white transition hover:bg-[#303030]" %>
            </div>
        </div>
        <% end %>
    </section>
</div>
