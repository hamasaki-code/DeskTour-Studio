<% content_for :title, t("posts.edit.title") %>
<% content_for :description, t("posts.edit.description") %>

<section class="space-y-content" data-page-content>
    <div class="space-y-3">
        <h1 class="ds-heading-xl ds-text-strong"><%= t("posts.edit.heading") %></h1>
        <div class="flex items-center gap-2 ds-text-support">
            <span><%= t("posts.edit.current_status") %></span>
            <%= post_status_badge(@post.status) %>
        </div>
    </div>

    <div class="rounded-2xl border ds-border-subtle ds-surface-panel p-5 sm:p-6">
        <%= render "form",
               post: @post,
               owned_users: @owned_users,
               category_suggestions: @category_suggestions,
               tag_suggestions: @tag_suggestions %>
    </div>
</section>

<section class="hidden" data-page-skeleton aria-hidden="true">
    <%= render "shared/screen_skeleton", variant: :detail %>
</section>