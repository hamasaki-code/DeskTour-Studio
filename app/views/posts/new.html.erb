<% content_for :title, "Create Post" %>
<% content_for :description, "Create a new desk post on DeskTour Studio." %>

<section class="mx-auto w-full max-w-3xl space-y-6">
  <div>
    <h1 class="text-2xl font-bold text-slate-900">Create Post</h1>
    <p class="mt-2 text-sm text-slate-600">
      Publish when ready, or save as draft and continue later.
    </p>
  </div>

  <div class="rounded-xl border border-slate-200 bg-white p-6">
    <%= render "form", post: @post %>
  </div>
</section>
