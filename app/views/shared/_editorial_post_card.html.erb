<% destination = local_assigns.fetch(:destination, editorial_entry_destination(post)) %>
<% interactive_class = destination.present? ? "transition duration-300 hover:-translate-y-1 hover:shadow-[0_24px_70px_rgba(26,26,26,0.1)]" : "" %>
<% wrapper_class = "group block overflow-hidden rounded-[24px] border border-[#e8e6e1] bg-white text-[#1a1a1a] shadow-[0_18px_60px_rgba(26,26,26,0.06)] #{interactive_class}" %>

<% if destination.present? %>
<%= link_to destination, class: wrapper_class do %>
<article>
    <div class="aspect-[4/3] overflow-hidden bg-[#ece9e2]">
        <%= editorial_entry_image_tag(post, variant: :thumbnail, class: "h-full w-full object-cover transition duration-500 group-hover:scale-[1.03]") %>
    </div>

    <div class="space-y-4 p-5">
        <div class="flex flex-wrap gap-2">
            <% editorial_entry_tags(post).first(2).each do |tag| %>
            <span class="rounded-full bg-[#f2f0ea] px-3 py-1 text-xs font-medium text-[#6b6b6b]"><%= tag %></span>
            <% end %>
        </div>

        <div class="space-y-2">
            <h3 class="text-lg font-medium tracking-[-0.02em]"><%= editorial_entry_title(post) %></h3>
            <p class="text-sm leading-6 text-[#6b6b6b]"><%= truncate(editorial_entry_description(post), length: 110) %></p>
        </div>

        <div class="flex items-center justify-between gap-3 text-sm text-[#6b6b6b]">
            <div>
                <p class="font-medium text-[#1a1a1a]"><%= editorial_entry_author_name(post) %></p>
                <p><%= editorial_entry_date_label(post) %></p>
            </div>
            <span class="rounded-full border border-[#e8e6e1] px-3 py-1"><%= t("editorial.shared.likes_count", count: localized_number(editorial_entry_likes(post))) %></span>
        </div>
    </div>
</article>
<% end %>
<% else %>
<div class="<%= wrapper_class %>">
    <article>
        <div class="aspect-[4/3] overflow-hidden bg-[#ece9e2]">
            <%= editorial_entry_image_tag(post, variant: :thumbnail, class: "h-full w-full object-cover") %>
        </div>

        <div class="space-y-4 p-5">
            <div class="flex flex-wrap gap-2">
                <% editorial_entry_tags(post).first(2).each do |tag| %>
                <span class="rounded-full bg-[#f2f0ea] px-3 py-1 text-xs font-medium text-[#6b6b6b]"><%= tag %></span>
                <% end %>
            </div>

            <div class="space-y-2">
                <h3 class="text-lg font-medium tracking-[-0.02em]"><%= editorial_entry_title(post) %></h3>
                <p class="text-sm leading-6 text-[#6b6b6b]"><%= truncate(editorial_entry_description(post), length: 110) %></p>
            </div>

            <div class="flex items-center justify-between gap-3 text-sm text-[#6b6b6b]">
                <div>
                    <p class="font-medium text-[#1a1a1a]"><%= editorial_entry_author_name(post) %></p>
                    <p><%= editorial_entry_date_label(post) %></p>
                </div>
                <span class="rounded-full border border-[#e8e6e1] px-3 py-1"><%= t("editorial.shared.likes_count", count: localized_number(editorial_entry_likes(post))) %></span>
            </div>
        </div>
    </article>
</div>
<% end %>
