<% notice = policy_revision_notice %>
<% return if notice.blank? %>

<section class="mb-4 rounded-lg border ds-tone-info px-4 py-3" role="status" aria-live="polite">
  <div class="flex flex-wrap items-start justify-between gap-2">
    <div class="space-y-1">
      <p class="text-xs font-semibold uppercase tracking-wide"><%= t("legal.revision.title", id: notice[:id]) %></p>
      <% if notice[:effective_on].present? %>
        <p class="text-xs ds-text-weak"><%= t("legal.revision.effective_on", date: notice[:effective_on]) %></p>
      <% end %>
      <p class="text-sm"><%= notice[:summary] %></p>
      <% if notice[:highlights].any? %>
        <ul class="list-disc space-y-0.5 pl-5 text-xs ds-text-support">
          <% notice[:highlights].each do |line| %>
            <li><%= line %></li>
          <% end %>
        </ul>
      <% end %>
    </div>
    <%= link_to t("legal.revision.view_changes"), notice[:link], class: "tap-target cta-tertiary cta-compact" %>
  </div>
</section>
