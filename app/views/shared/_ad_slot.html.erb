<% if adsense_enabled? && slot.present? %>
  <div class="my-8 flex justify-center">
    <ins class="adsbygoogle"
         style="display:block"
         data-ad-client="<%= ENV["ADSENSE_CLIENT_ID"] %>"
         data-ad-slot="<%= slot %>"
         data-ad-format="auto"
         data-full-width-responsive="true"></ins>
    <script>
      (adsbygoogle = window.adsbygoogle || []).push({});
    </script>
  </div>
<% end %>
